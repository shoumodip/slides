VIEWPORT   :: f32(0.8)
BACKGROUND :: rl.Color {245, 245, 245, 255}
FOREGROUND :: rl.Color {0, 0, 0, 255}

SPINNER_DURATION :: 0.6
SPINNER_COLOR    :: rl.Color {80, 80, 80, 255}

FONT                 :: #embed "fonts/DMSans-Regular.ttf"
BASE_FONT_SIZE       :: 60
MAXIMUM_LOADED_FONTS :: 20

main :: () {
    checkpoint := arena.default.alloc(0)
    defer arena.default.reset(checkpoint)

    rl.SetConfigFlags(.WINDOW_RESIZABLE)
    rl.InitWindow(800, 600, "Slides")
    rl.SetExitKey(.Q)
    defer rl.CloseWindow()

    app: App
    defer app.free()

    if os.args.count == 2 {
        app.load_file(os.args[1])
    }

    message: &char = "Drag and Drop slideshow file"
    message_width := rl.MeasureTextEx(app.load_font(BASE_FONT_SIZE), message, f32(BASE_FONT_SIZE), 0.0).x

    current := 0
    for !rl.WindowShouldClose() {
        w := f32(rl.GetScreenWidth())
        h := f32(rl.GetScreenHeight())

        rl.BeginDrawing()
        rl.ClearBackground(BACKGROUND)
        if app.slides.count == 0 {
            scale := min(w * VIEWPORT / message_width, h * VIEWPORT / f32(BASE_FONT_SIZE))
            size  := f32(BASE_FONT_SIZE) * scale
            rl.DrawTextEx(
                app.load_font(s32(size)),
                message,
                {(w - message_width * scale) / 2.0, (h - size) / 2.0},
                size,
                0.0,
                FOREGROUND
            )
        } else {
            app.slides[current].draw(&app)
        }
        rl.EndDrawing()

        if rl.IsKeyReleased(.J) || rl.IsKeyReleased(.L) || rl.IsKeyReleased(.DOWN) || rl.IsKeyReleased(.RIGHT) {
            if current + 1 < app.slides.count {
                current += 1
            }
        }

        if rl.IsKeyReleased(.K) || rl.IsKeyReleased(.H) || rl.IsKeyReleased(.UP) || rl.IsKeyReleased(.LEFT) {
            if current > 0 {
                current -= 1
            }
        }

        if rl.IsMouseButtonReleased(.LEFT) {
            mouse := rl.GetMousePosition()
            if mouse.x >= 0.75 * w {
                if current + 1 < app.slides.count {
                    current += 1
                }
            }

            if mouse.x <= 0.25 * w {
                if current > 0 {
                    current -= 1
                }
            }
        }

        if rl.IsFileDropped() {
            list := rl.LoadDroppedFiles()
            defer rl.UnloadDroppedFiles(list)

            if list.count > 0 {
                app.stop_worker()

                current = 0
                for i := 0; i < app.slides.count; i += 1 {
                    app.slides[i].free()
                }
                app.slides.count = 0

                arena.default.reset(checkpoint)
                app.load_file(strings.from_cstring(*list.paths))
            }
        }
    }
}

App :: struct {
    fonts:  [..]rl.Font
    slides: [..]Slide

    thread:       pthread.Pthread
    thread_arena: arena.Arena
}

free :: (this: &App) {
    for i := 0; i < this.fonts.count; i += 1 {
        rl.UnloadFont(this.fonts[i])
    }
    this.fonts.free()

    for i := 0; i < this.slides.count; i += 1 {
        this.slides[i].free()
    }
    this.slides.free()

    this.stop_worker()
    this.thread_arena.free()
}

load_file :: (this: &App, path: string) {
    contents, ok := os.read_entire_file(path)
    if !ok then return

    text: &Text
    for contents := string(contents); contents.count != 0 {
        line: string; ok: bool
        line, contents, ok = strings.split(contents, '\n')

        if line.count == 0 {
            text = null
            continue
        }

        if line[0] == {
        case '#'
            text = null
            continue

        case '@'
            this.slides.push(Image {path = line[1..]})
            continue

        case '\\'
            line = line[1..]
        }

        if text == null {
            this.slides.push(Text {})
            text = &this.slides[this.slides.count - 1].(Text)
        }

        text.lines.push(line)
    }

    this.start_worker()
}

load_font :: (this: &App, size: s32) -> rl.Font {
    for i := 0; i < this.fonts.count; i += 1 {
        f := this.fonts[i]
        if diff(f.baseSize, size) <= 20 {
            return f
        }
    }

    if this.fonts.count > MAXIMUM_LOADED_FONTS {
        for i := MAXIMUM_LOADED_FONTS; i < this.fonts.count; i += 1 {
            rl.UnloadFont(this.fonts[i])
        }
        this.fonts.count = MAXIMUM_LOADED_FONTS
    }

    f := rl.LoadFontFromMemory(".ttf", FONT.data, s32(FONT.count) + 1, size, null, 0)
    if rl.IsFontValid(f) {
        rl.GenTextureMipmaps(&f.texture)
        rl.SetTextureFilter(f.texture, .TRILINEAR)
    }
    this.fonts.push(f)
    return f
}

stop_worker :: (this: &App) {
    if this.thread != 0 {
        this.thread.cancel()
        this.thread.join(null)
        this.thread = 0
    }
}

start_worker :: (this: &App) {
    if this.thread_arena.capacity == 0 {
        this.thread_arena.capacity = 64 * 1024
    }
    this.thread_arena.head = 0

    if bool(this.thread.create(null, worker, rawptr(this))) {
        rl.TraceLog(.ERROR, "Could not start worker thread. Executing it on the main thread")
        worker(rawptr(this))
    }

    worker :: (arg: rawptr) -> rawptr {
        app := &App(arg)
        for i := 0; i < app.slides.count; i += 1 {
            if app.slides[i] == Image {
                image := &app.slides[i].(Image)
                path  := strings.to_cstring(image.path, &app.thread_arena)
                defer app.thread_arena.reset(rawptr(path))
                image.data = rl.LoadImage(path)
            }
        }
        return null
    }
}

Slide :: union {
    Text
    Image
}

free :: (this: &Slide) {
    s := *this
    if s == {
    case Image
        data := s.data
        if data == {
        case rl.Image;   rl.UnloadImage(data)
        case rl.Texture; rl.UnloadTexture(data)
        case null
        }

    case Text; s.lines.free()
    case null
    }

    C.memset(rawptr(this), 0, sizeof(*this))
}

draw :: (this: &Slide, app: &App) {
    checkpoint := arena.temporary.alloc(0)
    defer arena.temporary.reset(checkpoint)

    w := f32(rl.GetScreenWidth())
    h := f32(rl.GetScreenHeight())
    if *this == {
    case Text
        s := &(*this).(Text)
        if !s.ready {
            s.ready = true
            font := app.load_font(BASE_FONT_SIZE)
            for i := 0; i < s.lines.count; i += 1 {
                s.width = max(
                    s.width,
                    rl.MeasureTextEx(font, strings.to_cstring(s.lines[i], &arena.temporary), f32(BASE_FONT_SIZE), 0.0).x
                )
            }
        }

        scale := min(w * VIEWPORT / s.width, h * VIEWPORT / f32(BASE_FONT_SIZE) / f32(s.lines.count))
        size  := f32(BASE_FONT_SIZE) * scale
        position := rl.Vector2 {
            x = (w - s.width * scale) / 2.0,
            y = (h - size * f32(s.lines.count)) / 2.0,
        }

        font := app.load_font(s32(size))
        for i := 0; i < s.lines.count; i += 1 {
            rl.DrawTextEx(font, strings.to_cstring(s.lines[i], &arena.temporary), position, size, 0.0, FOREGROUND)
            position.y += size
        }

    case Image
        s := &(*this).(Image)
        data := s.data

        if data == {
        case rl.Image
            defer rl.UnloadImage(data)

            texture := rl.LoadTextureFromImage(data)
            rl.GenTextureMipmaps(&texture)
            rl.SetTextureFilter(texture, .TRILINEAR)
            s.data = texture

        case rl.Texture
            scale := min(w * VIEWPORT / f32(data.width), h * VIEWPORT / f32(data.height))
            WHITE :: rl.Color {0xFF, 0xFF, 0xFF, 0xFF}
            rl.DrawTextureEx(
                data,
                {(w - f32(data.width) * scale) / 2.0, (h - f32(data.height) * scale) / 2.0},
                0.0,
                scale,
                WHITE
            )

        case null
            #static spinner := f32(0.0)

            center := rl.Vector2 {w / 2.0, h / 2.0}
            size   := min(w, h) * 0.08

            spinner += rl.GetFrameTime()
            if spinner >= SPINNER_DURATION {
                spinner = 0.0
            }

            progress := spinner / SPINNER_DURATION
            baseAngle := progress * 360.0

            segments    := 12
            orbitRadius := size * 0.5
            dotRadius   := size * 0.08
            for i := 0; i < segments; i += 1 {
                angle    := baseAngle + (f32(i) / f32(segments)) * 360.0
                position := center + rl.Vector2 {orbitRadius}.rotate(angle * DEG2RAD)
                rl.DrawCircleV(position, dotRadius, rl.Fade(SPINNER_COLOR, f32(i + 1) / f32(segments)))

                PI      :: 3.14159265358979323846
                DEG2RAD :: PI / 180.0
                RAD2DEG :: 180.0 / PI
            }
        }

    case null
    }
}

Text :: struct {
    lines: [..]string
    width: f32
    ready: bool
}

Image :: struct {
    path: string
    data: union {
        rl.Image
        rl.Texture
    }
}

min :: (a: $T, b: T) -> T {
    if a < b then return a else return b
}

max :: (a: $T, b: T) -> T {
    if a > b then return a else return b
}

diff :: (a: $T, b: T) -> T {
    if a > b then return a - b else return b - a
}

C       :: #import "C"
os      :: #import "os"
arena   :: #import "arena"
strings :: #import "strings"

rl      :: #import "raylib"
pthread :: #import "pthread"
