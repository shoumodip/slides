extern {
    #library "raylib_linux"

    TraceLog :: (logLevel: TraceLogLevel, text: &C.char, ...)
    InitWindow :: (width: C.int, height: C.int, title: &C.char)
    CloseWindow :: ()
    WindowShouldClose :: () -> bool
    BeginDrawing :: ()
    EndDrawing :: ()

    Fade :: (color: Color, alpha: C.float) -> Color
    ClearBackground :: (color: Color)

    DrawCircleV :: (center: Vector2, radius: C.float, color: Color)

    GetFrameTime :: () -> C.float

    IsKeyReleased :: (key: Key) -> bool
    IsMouseButtonReleased :: (button: MouseButton) -> bool

    LoadFontFromMemory :: (fileType: &C.char, fileData: &C.char, dataSize: C.int, fontSize: C.int, codepoints: &C.int, codepointCount: C.int) -> Font
    IsFontValid :: (font: Font) -> bool
    UnloadFont :: (font: Font)

    DrawTextEx :: (font: Font, text: &C.char, position: Vector2, fontSize: C.float, spacing: C.float, tint: Color)
    MeasureTextEx :: (font: Font, text: &C.char, fontSize: C.float, spacing: C.float) -> Vector2

    GenTextureMipmaps :: (texture: &Texture2D)
    SetTextureFilter :: (texture: Texture2D, filter: TextureFilter)
    LoadTextureFromImage :: (image: Image) -> Texture2D
    DrawTextureEx :: (texture: Texture2D, position: Vector2, rotation: C.float, scale: C.float, tint: Color)
    UnloadTexture :: (font: Texture)

    LoadImage :: (fileName: &C.char) -> Image
    UnloadImage :: (font: Image)
    IsImageValid :: (image: Image) -> bool

    SetConfigFlags :: (flags: ConfigFlags)
    SetExitKey :: (key: Key)

    GetScreenWidth :: () -> C.int
    GetScreenHeight :: () -> C.int
    GetMousePosition :: () -> Vector2

    IsFileDropped :: () -> bool
    LoadDroppedFiles :: () -> FilePathList
    UnloadDroppedFiles :: (files: FilePathList)
}

Vector2 :: struct {
    x: C.float
    y: C.float
}

operator + :: (this: Vector2, that: Vector2) -> Vector2 {
    return {this.x + that.x, this.y + that.y}
}

rotate :: (this: Vector2, angle: C.float) -> Vector2 {
    cosres := angle.cos()
    sinres := angle.sin()
    return {this.x*cosres - this.y*sinres, this.x*sinres + this.y*cosres}
}

TraceLogLevel :: enum C.int {
    ALL = 0
    TRACE
    DEBUG
    INFO
    WARNING
    ERROR
    FATAL
    NONE
}

Rectangle :: struct {
    x:      C.float
    y:      C.float
    width:  C.float
    height: C.float
}

Color :: struct {
    r: C.unsigned_char
    g: C.unsigned_char
    b: C.unsigned_char
    a: C.unsigned_char
}

Font :: struct {
    baseSize:     C.int
    glyphCount:   C.int
    glyphPadding: C.int
    texture:      Texture2D
    recs:         &Rectangle
    glyphs:       &GlyphInfo
}

Image :: struct {
    data:    rawptr
    width:   C.int
    height:  C.int
    mipmaps: C.int
    format:  C.int
}

Texture :: struct {
    id:      C.unsigned_int
    width:   C.int
    height:  C.int
    mipmaps: C.int
    format:  C.int
}

Texture2D :: Texture

GlyphInfo :: struct {
    value:    C.int
    offsetX:  C.int
    offsetY:  C.int
    advanceX: C.int
    image:    Image
}


ConfigFlags :: enum C.unsigned_int {
    WINDOW_RESIZABLE = 0x00000004
}

TextureFilter :: enum C.int {
    POINT = 0
    BILINEAR
    TRILINEAR
    ANISOTROPIC_4X
    ANISOTROPIC_8X
    ANISOTROPIC_16X
}

Key :: enum C.int {
    H     = 72
    J     = 74
    K     = 75
    L     = 76
    Q     = 81
    RIGHT = 262
    LEFT  = 263
    DOWN  = 264
    UP    = 265
}

MouseButton :: enum C.int {
    LEFT    = 0
    RIGHT   = 1
    MIDDLE  = 2
    SIDE    = 3
    EXTRA   = 4
    FORWARD = 5
    BACK    = 6
}

FilePathList :: struct {
    capacity: C.unsigned_int
    count:    C.unsigned_int
    paths:    &&C.char
}

C    :: #import "C"
math :: #import "math"
